# ============================================
# biliLive-tools Docker 密钥配置
# ============================================
# 使用方法：复制此文件为 .env 并填入你的密钥
#   cp docker/.env.example docker/.env
#
# 不配置的后果：
#   - 首次启动时自动生成随机密钥并打印到日志
#   - 每次重建容器密钥会变，旧加密数据将无法解密
# ============================================

# 登录鉴权密钥（WebUI 登录密码）
BILILIVE_TOOLS_PASSKEY=your_passkey_here

# B站账户数据加密密钥（用于加密存储 B站 cookie/access_token）
BILILIVE_TOOLS_BILIKEY=your_bilikey_here

# 旧版加密密钥（仅从 2026-06-16 之前版本升级的用户需要）
# 填写升级前使用的密钥，应用会自动将历史数据重新加密到新密钥
# BILILIVE_TOOLS_BILIKEY_PREV=your_old_bilikey_here
